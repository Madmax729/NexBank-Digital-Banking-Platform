# ========================================
# Digital Banking System - Environment Variables
# ========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ========================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=banking_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=banking_system

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT (generate a secure Base64 secret for production)
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_SECRET
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Eureka
EUREKA_HOST=discovery-server
EUREKA_PORT=8761

# Config Server
CONFIG_SERVER_HOST=config-server
CONFIG_SERVER_PORT=8888

# Zipkin
ZIPKIN_HOST=zipkin
ZIPKIN_PORT=9411

# Service Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ACCOUNT_SERVICE_PORT=8083
TRANSACTION_SERVICE_PORT=8084
LEDGER_SERVICE_PORT=8085
UPI_SERVICE_PORT=8086
CURRENCY_SERVICE_PORT=8087
FRAUD_SERVICE_PORT=8088
NOTIFICATION_SERVICE_PORT=8089
AUDIT_SERVICE_PORT=8090
ADMIN_SERVICE_PORT=8091

# ========================================
# Live Exchange Rate API (ExchangeRate-API)
# Get your FREE key at: https://www.exchangerate-api.com/
# Leave empty to use static fallback rates
# ========================================
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_BASE_URL=https://v6.exchangerate-api.com/v6

# ========================================
# Fraud Detection Thresholds
# ========================================
FRAUD_LARGE_AMOUNT_THRESHOLD=100000
FRAUD_CROSS_CURRENCY_THRESHOLD=50000

# ========================================
# CORS Allowed Origins (comma-separated)
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================================
# pgAdmin (PostgreSQL Web UI)
# Access at: http://localhost:5050
# ========================================
PGADMIN_EMAIL=admin@nexbank.com
PGADMIN_PASSWORD=CHANGE_ME
